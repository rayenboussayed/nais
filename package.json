{
  "name": "trainslator",
  "version": "0.1.0",
  "description": "Standalone AI translation service (NestJS + Ollama + PostgreSQL)",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/shared && npm run build --workspaces --if-present",
    "generate:api": "node apps/api/bin/openapi.mjs && npx openapi-typescript apps/api/test/fixtures/openapi.golden.json -o generated/api.d.ts && npx openapi-typescript generated/ws.openapi.json -o generated/ws.d.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,mts,mjs,tsx,css,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,mts,mjs,tsx,css,md,json,yml,yaml}\"",
    "test": "vitest run --passWithNoTests",
    "test:mem": "vitest run --config vitest.memory.config.mts",
    "test:prof": "vitest run --config vitest.profile.config.mts",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "test:cov:changed": "vitest run --changed --coverage --coverage.thresholds.perFile=true --coverage.thresholds.lines=95 --coverage.thresholds.functions=95 --coverage.thresholds.branches=95 --coverage.thresholds.statements=95 --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.mts",
    "test:perf": "vitest bench --reporter=verbose",
    "knip": "knip",
    "auth:hash": "node scripts/scrypt-hash.mjs",
    "check": "npm run build && npm run typecheck && npm run lint && npm run test && npm run knip && npm run format:check",
    "db:generate": "npm run db:generate --workspace=@trainslator/api",
    "db:migrate": "npm run db:migrate --workspace=@trainslator/api",
    "db:seed": "npm run db:seed --workspace=@trainslator/api",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "overrides": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@deslint/eslint-plugin": "^0.10.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^9.0.0",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-istanbul": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-de-morgan": "^2.3.0",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-jsdoc": "^65.5.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^80.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "knip": "^6.14.2",
    "openapi-typescript": "^6.7.6",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf": false
  }
}
