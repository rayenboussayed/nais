# syntax=docker/dockerfile:1
#
# Development image: installs all dependencies and runs the API in watch mode.
# The repository is bind-mounted at runtime (see docker-compose.dev.yml); the
# baked node_modules overlay keeps platform-correct binaries.
#
# Note: the container intentionally runs as root. Bind-mounting the repository
# onto an overlay whose ownership does not match the host user breaks file
# watching/writes for non-root uids; the production image (apps/api/Dockerfile)
# runs as `node`. Dev mode never holds production secrets and is not exposed
# beyond the developer's machine.
FROM node:24-bookworm-slim
WORKDIR /repo

COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/

RUN npm ci

# The API imports the built shared package; bake it in for watch mode.
RUN npm run build -w packages/shared

COPY . .

EXPOSE 3000
# Prometheus /metrics when OTEL_TRACE_EXPORTER_URL is set (opt-in)
EXPOSE 8888
CMD ["npm", "run", "start:dev", "-w", "@trainslator/api"]
