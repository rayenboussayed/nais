POSTGRES_USER=trainslator
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trainslator
DATABASE_URL=postgresql://trainslator:change-me@localhost:5432/trainslator

PORT=3000
NODE_ENV=development

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=bonsai-2:2b

BASIC_AUTH_USERNAME=admin
# scrypt hash of the password, format scrypt$N$r$p$saltHex$hashHex (empty = required)
# generate with: npm run auth:hash -- --password 'your-password'
BASIC_AUTH_PASSWORD_HASH=
# 64+ random hex chars, used to sign session cookies: openssl rand -hex 32
SESSION_SECRET=

# pg-boss connection (its own schema keeps it isolated from Drizzle's).
# Defaults to DATABASE_URL when unset.
PG_BOSS_URL=postgresql://trainslator:change-me@localhost:5432/trainslator

# extra allowed browser origins for CORS/WS, comma separated; leave empty for same-origin only
CORS_ORIGINS=

OLLAMA_TIMEOUT_MS=60000

# default per-client-IP rate limit per minute (translate route has its own 30/min cap)
# THROTTLE_LIMIT=100

# --- general AI service (transformers.js) ---
# location of the ONNX model cache (defaults to the library's built-in cache dir)
# HF_CACHE_DIR=/hf-cache
# max concurrent model calls on the REST path (queue worker stays serial)
# AI_MAX_CONCURRENCY=2
# pin the ONNX compute device (unset = automatic webgpu → cpu fallback)
# AI_DEVICE=webgpu
# per-task dedicated-model overrides; unset keeps the registry defaults
# AI_SENTIMENT_MODEL=Xenova/distilbert-base-uncased-finetuned-sst-2-english
# AI_SUMMARIZE_MODEL=Xenova/distilbart-cnn-6-6
# AI_QUESTION_ANSWERING_MODEL=Xenova/distilbert-base-uncased-distilled-squad
# AI_TOKEN_CLASSIFICATION_MODEL=Xenova/bert-base-cased-finetuned-conll03-english
# AI_ZERO_SHOT_CLASSIFICATION_MODEL=Xenova/nli-deberta-v3-xsmall
# AI_FEATURE_EXTRACTION_MODEL=onnx-community/all-MiniLM-L6-v2-ONNX

# test-only knobs for the throwaway PostgreSQL harness (apps/api/test/pg-temp.ts)
# PG_BIN=/usr/lib/postgresql/16/bin
# PG_TEST_TIMEOUT_MS=30000

# --- OpenTelemetry (optional; unset = telemetry fully disabled) ---
# OTLP/HTTP trace endpoint for the API; setting it enables traces plus
# Prometheus /metrics on OTEL_METRICS_PORT (bound to 0.0.0.0).
# OTEL_TRACE_EXPORTER_URL=http://localhost:4318/v1/traces
# Prometheus /metrics port (default 8888)
# OTEL_METRICS_PORT=8888
# verbose OTEL diagnostics in development (true/false)
# OTEL_DIAG_ENABLED=false
